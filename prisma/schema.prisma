// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SlaStatus {
  WITHIN_SLA
  AT_RISK
  BREACHED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_UPDATED
  MENTION
  SLA_WARNING
  SLA_BREACHED
  WORKFLOW_EXECUTED
}

enum ReportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum WorkflowTriggerEvent {
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_STATUS_CHANGED
  TICKET_ASSIGNED
  TICKET_RESOLVED
}

enum WorkflowActionType {
  ASSIGN_USER
  CHANGE_STATUS
  SEND_EMAIL
  CREATE_NOTIFICATION
  CREATE_TASK
}

enum WorkflowOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  GREATER_THAN
  LESS_THAN
  IN
  NOT_IN
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id       String             @id @default(uuid()) @db.Uuid
  name     String             @db.VarChar(150)
  slug     String             @unique @db.VarChar(150)
  email    String             @db.VarChar(255)
  phone    String?            @db.VarChar(50)
  timezone String             @default("UTC") @db.VarChar(50)
  status   OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  roles               Role[]
  customers           Customer[]
  projects            Project[]
  tasks               Task[]
  ticketCategories    TicketCategory[]
  tickets             Ticket[]
  ticketStatusHistory TicketStatusHistory[]
  comments            Comment[]
  attachments         Attachment[]
  activities          Activity[]
  notifications       Notification[]
  slaPolicies         SlaPolicy[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  auditLogs           AuditLog[]
  apiKeys             ApiKey[]
  reportJobs          ReportJob[]
  invitations         Invitation[]
  passwordResetTokens PasswordResetToken[]

  @@map("organizations")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  name           String     @db.VarChar(150)
  email          String     @db.VarChar(255)
  passwordHash   String     @db.VarChar(255)
  status         UserStatus @default(INVITED)
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roles               UserRole[]
  sessions            Session[]
  invitationsCreated  Invitation[]          @relation("InvitationCreatedBy")
  comments            Comment[]
  attachments         Attachment[]
  activities          Activity[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  apiKeysCreated      ApiKey[]
  projectsCreated     Project[]             @relation("ProjectCreatedBy")
  tasksCreated        Task[]                @relation("TaskCreatedBy")
  tasksAssigned       Task[]                @relation("TaskAssignee")
  ticketsCreated      Ticket[]              @relation("TicketCreatedBy")
  ticketsAssigned     Ticket[]              @relation("TicketAssignee")
  ticketStatusChanges TicketStatusHistory[]
  workflowsCreated    Workflow[]            @relation("WorkflowCreatedBy")
  reportJobs          ReportJob[]           @relation("ReportRequestedBy")
  projectMemberships  ProjectMember[]

  passwordResetTokens PasswordResetToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  name           String  @db.VarChar(100)
  description    String? @db.Text
  isGlobal       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users       UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(100)
  description String? @db.Text
  module      String  @db.VarChar(50)

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// CRM + Projects

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String         @db.VarChar(150)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(50)
  company        String?        @db.VarChar(150)
  address        String?        @db.VarChar(255)
  notes          String?        @db.Text
  status         CustomerStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projects Project[]
  tickets  Ticket[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("customers")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  customerId     String        @db.Uuid
  name           String        @db.VarChar(200)
  description    String?       @db.Text
  status         ProjectStatus @default(PLANNED)
  priority       Priority      @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  createdById    String        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  members ProjectMember[]
  tasks   Task[]
  tickets Ticket[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  projectId String @db.Uuid
  userId    String @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  projectId      String     @db.Uuid
  title          String     @db.VarChar(200)
  description    String?    @db.Text
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assigneeId     String?    @db.Uuid
  createdById    String     @db.Uuid
  dueDate        DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([projectId])
  @@index([assigneeId])
  @@index([createdById])
  @@map("tasks")
}

// Tickets + SLA

model TicketSla {
  id          String @id @default(uuid()) @db.Uuid
  ticketId    String @unique @db.Uuid
  slaPolicyId String @db.Uuid

  firstResponseDueAt DateTime?
  firstResponseAt    DateTime?
  resolutionDueAt    DateTime?
  resolvedAt         DateTime?

  firstResponseStatus SlaStatus?
  resolutionStatus    SlaStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slaPolicy SlaPolicy @relation(fields: [slaPolicyId], references: [id], onDelete: Restrict)

  ticketSlaPauses TicketSlaPause[]
  

  @@index([slaPolicyId])
  @@index([firstResponseStatus])
  @@index([resolutionStatus])
  @@map("ticket_slas")
}

model Comment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  ticketId       String  @db.Uuid
  userId         String  @db.Uuid
  content        String  @db.Text
  isInternal     Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ticketId])
  @@index([userId])
  @@map("comments")
}

model Attachment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  ticketId       String? @db.Uuid
  userId         String  @db.Uuid

  fileName     String @db.VarChar(255)
  originalName String @db.VarChar(255)
  mimeType     String @db.VarChar(100)
  fileSize     BigInt
  storagePath  String @db.Text

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ticketId])
  @@index([userId])
  @@map("attachments")
}

model Activity {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  userId         String? @db.Uuid

  entityType  String  @db.VarChar(50)
  entityId    String  @db.Uuid
  action      String  @db.VarChar(100)
  description String? @db.Text
  metadata    Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([organizationId, createdAt])
  @@map("activities")
}

model Notification {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid

  type    NotificationType
  title   String           @db.VarChar(200)
  message String           @db.Text

  entityType String? @db.VarChar(50)
  entityId   String? @db.Uuid

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, isRead])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model TicketCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String  @db.VarChar(100)
  description    String? @db.Text
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("ticket_categories")
}

model Ticket {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  customerId     String  @db.Uuid
  projectId      String? @db.Uuid
  categoryId     String? @db.Uuid
  createdById    String  @db.Uuid
  assignedToId   String? @db.Uuid
  slaPolicyId    String? @db.Uuid

  subject     String       @db.VarChar(200)
  description String?      @db.Text
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)

  openedAt   DateTime  @default(now())
  resolvedAt DateTime?
  closedAt   DateTime?

  slaDueAt        DateTime?
  firstResponseAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category      TicketCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy     User                  @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo    User?                 @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  slaPolicy     SlaPolicy?            @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  sla           TicketSla?
  statusHistory TicketStatusHistory[]
  comments      Comment[]
  attachments   Attachment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([projectId])
  @@index([categoryId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([slaPolicyId])
  @@map("tickets")
}

model TicketStatusHistory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId       String @db.Uuid
  changedById    String @db.Uuid

  fromStatus TicketStatus?
  toStatus   TicketStatus

  changedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy    User         @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ticketId])
  @@index([changedById])
  @@map("ticket_status_history")
}

model SlaPolicy {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String  @db.VarChar(100)
  description    String? @db.Text

  priority Priority

  firstResponseMinutes Int
  resolutionMinutes    Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets         Ticket[]
  ticketSlas      TicketSla[]
  businessHours   SlaBusinessHour[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, priority])
  @@map("sla_policies")
}

// Automation + Platform

model Workflow {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String               @db.VarChar(150)
  description    String?              @db.Text
  triggerEvent   WorkflowTriggerEvent
  isActive       Boolean              @default(true)
  createdById    String               @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  conditions WorkflowCondition[]
  actions    WorkflowAction[]
  executions WorkflowExecution[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([createdById])
  @@map("workflows")
}

model WorkflowCondition {
  id           String           @id @default(uuid()) @db.Uuid
  workflowId   String           @db.Uuid
  field        String           @db.VarChar(100)
  operator     WorkflowOperator
  value        String           @db.Text
  logicalGroup Int              @default(0)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_conditions")
}

model WorkflowAction {
  id             String             @id @default(uuid()) @db.Uuid
  workflowId     String             @db.Uuid
  type           WorkflowActionType
  configuration  Json
  executionOrder Int

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([workflowId, executionOrder])
  @@map("workflow_actions")
}

model WorkflowExecution {
  id                String                  @id @default(uuid()) @db.Uuid
  workflowId        String                  @db.Uuid
  organizationId    String                  @db.Uuid
  triggerEntityType String                  @db.VarChar(50)
  triggerEntityId   String                  @db.Uuid
  status            WorkflowExecutionStatus @default(PENDING)
  completedAt       DateTime?
  error             String?                 @db.Text
  startedAt         DateTime?
  createdAt         DateTime                @default(now())

  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowId])
  @@index([workflowId, status])
  @@index([triggerEntityType, triggerEntityId])
  @@map("workflow_executions")
}

model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  userId         String? @db.Uuid
  action         String  @db.VarChar(100)
  entityType     String  @db.VarChar(50)
  entityId       String? @db.Uuid
  oldValues      Json?
  newValues      Json?
  ipAddress      String? @db.VarChar(45)
  userAgent      String? @db.Text

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(100)
  keyPrefix      String    @db.VarChar(20)
  keyHash        String    @db.VarChar(255)
  scopes         Json?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String    @db.Uuid

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, revokedAt])
  @@index([createdById])
  @@index([keyPrefix])
  @@map("api_keys")
}

model ReportJob {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  requestedById  String          @db.Uuid
  type           String          @db.VarChar(100)
  parameters     Json?
  status         ReportJobStatus @default(PENDING)
  filePath       String?         @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?         @db.Text

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ReportRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([requestedById])
  @@map("report_jobs")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(255)
  expiresAt    DateTime
  lastActivity DateTime?
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  roleId         String @db.Uuid
  email          String @db.VarChar(255)
  tokenHash      String @unique @db.VarChar(255)
  invitedById    String @db.Uuid

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationCreatedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
  @@map("invitations")
}

model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String   @db.Uuid

  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @db.Uuid

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model TicketSlaPause {
  id              String   @id @default(uuid()) @db.Uuid
  ticketSlaId     String   @db.Uuid
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds BigInt?
  createdAt       DateTime @default(now())

  ticketSla TicketSla @relation(fields: [ticketSlaId], references: [id], onDelete: Cascade)

  @@index([ticketSlaId])
  @@map("ticket_sla_pauses")
}

model SlaBusinessHour {
  id          String @id @default(uuid()) @db.Uuid
  slaPolicyId String @db.Uuid

  dayOfWeek  Int
  startTime  String @db.VarChar(5)
  endTime    String @db.VarChar(5)

  slaPolicy SlaPolicy @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)

  @@unique([slaPolicyId, dayOfWeek])
  @@index([slaPolicyId])
  @@map("sla_business_hours")
}